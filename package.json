{
  "name": "@settle/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Programmable Settlement Infrastructure on Stellar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Praizfotos1/Settle.git"
  },
  "license": "MIT",
  "author": "Settle Team",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "contracts:build": "cargo build --manifest-path contracts/stellar-contract/Cargo.toml --target wasm32-unknown-unknown --release",
    "contracts:test": "cargo test --manifest-path contracts/stellar-contract/Cargo.toml",
    "backend:build": "cargo build --manifest-path backend/Cargo.toml",
    "backend:test": "cargo test --manifest-path backend/Cargo.toml",
    "backend:dev": "cargo run --manifest-path backend/Cargo.toml",
    "integration:test": "cd integration-tests && npm test",
    "e2e:test": "cd integration-tests && npm run e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}