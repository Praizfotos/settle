# ===========================================
# SETTLE — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ===========================================

# -------------------------------------------
# Database (Backend only — never expose to frontend)
# -------------------------------------------
DATABASE_URL=postgresql://settle:settle@localhost:5432/settle
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_LIFETIME=3600

# -------------------------------------------
# Stellar Network (Backend/Indexer)
# -------------------------------------------
# Network: "testnet" or "mainnet"
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS_HERE

# Secret key for backend-initiated transactions (optional, NEVER commit)
STELLAR_SECRET_KEY=

# -------------------------------------------
# Server
# -------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# -------------------------------------------
# Indexer
# -------------------------------------------
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_BATCH_SIZE=100
INDEXER_MAX_RETRIES=3
INDEXER_RETRY_DELAY_MS=1000

# -------------------------------------------
# Frontend (apps/web/.env.local)
# -------------------------------------------
# These are prefixed with NEXT_PUBLIC_ for Next.js client-side access.
# Create apps/web/.env.local with:
#   NEXT_PUBLIC_STELLAR_NETWORK=testnet
#   NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#   NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#   NEXT_PUBLIC_STELLAR_CONTRACT_ADDRESS=<deployed contract address>
#   NEXT_PUBLIC_API_URL=http://localhost:3000
